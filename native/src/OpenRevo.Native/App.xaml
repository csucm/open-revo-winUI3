          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#333D51"/>
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#333D51"/>
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#333D51"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <CornerRadius x:Key="ComboBoxDropDownCornerRadius">12</CornerRadius>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

      <!-- From approved suite.css geometry. Native controls retain input and UIA behavior. -->
      <Style x:Key="SuiteButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,6"/><Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{ThemeResource DesignCardFill}"/><Setter Property="Foreground" Value="{ThemeResource OverviewInk}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesignStroke}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource SuiteHoverFill}"/></VisualState.Setters></VisualState>
              <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource DesignInsetFill}"/></VisualState.Setters></VisualState>
              <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Surface.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource SuiteButtonStyle}"/>
      <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SuiteButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SemanticBlue}"/><Setter Property="Foreground" Value="{ThemeResource SuiteOnAccent}"/><Setter Property="BorderBrush" Value="Transparent"/>
      </Style>
      <Style TargetType="ComboBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="9,6"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="1"/></Style>
      <Style TargetType="ComboBoxItem"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="9,6"/><Setter Property="CornerRadius" Value="8"/></Style>
      <Style TargetType="NumberBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="34"/><Setter Property="CornerRadius" Value="8"/></Style>
      <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>
      <Thickness x:Key="ComboBoxPopupBorderThemeThickness">1</Thickness>
      <Style TargetType="ToggleSwitch">
        <Setter Property="Width" Value="40"/><Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="24"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleSwitch">
          <Grid x:Name="SwitchAreaGrid" Width="40" Height="24" Background="Transparent" Control.IsTemplateFocusTarget="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SwitchAreaGrid.Opacity" Value="0.6"/></VisualState.Setters></VisualState></VisualStateGroup>
              <VisualStateGroup x:Name="ToggleStates"><VisualState x:Name="Dragging"/><VisualState x:Name="Off"/>
                <VisualState x:Name="On"><VisualState.Setters>
                  <Setter Target="OuterBorder.Background" Value="{ThemeResource SuiteSwitchOnFill}"/><Setter Target="OuterBorder.BorderBrush" Value="{ThemeResource SuiteSwitchAccent}"/>
                  <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource SuiteSwitchAccent}"/><Setter Target="KnobTranslateTransform.X" Value="16"/>
                </VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="OuterBorder" Background="{ThemeResource SuiteOffFill}" BorderBrush="{ThemeResource DesignStroke}" BorderThickness="1" CornerRadius="12"/>
            <Grid x:Name="SwitchKnob" Width="24" Height="24" HorizontalAlignment="Left"><Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform"/></Grid.RenderTransform><Ellipse x:Name="SwitchKnobOff" Width="16" Height="16" Fill="{ThemeResource OverviewMuted}"/></Grid>
            <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw"><Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate></Thumb.Template></Thumb>
          </Grid>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="FanCurveThumbStyle" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
          <Ellipse Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="1.5" />
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="SelectedChoiceStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ChoiceFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ChoiceStroke}" />
        <Setter Property="Foreground" Value="{ThemeResource ChoiceText}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid x:Name="ChoiceRoot" Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters><Setter Target="ChoiceSurface.Opacity" Value="0.8" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters><Setter Target="ChoiceSurface.Opacity" Value="0.45" /></VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <!-- Selection belongs to the control, independent of pointer state. -->
                <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DesignCardFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DesignStroke}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="16" />
      </Style>
      <!-- Shared visual tokens apply to mini as well; its layout stays unchanged. -->
      <Style x:Key="DetailChoiceStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource DesignInsetFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DesignStroke}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="16" />
      </Style>
      <Style x:Key="DetailBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" /><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
      </Style>
      <Style x:Key="DetailBadgeIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="21" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
