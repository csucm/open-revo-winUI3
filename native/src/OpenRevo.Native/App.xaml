        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="DesignCardFill" Color="#252B37" />
          <SolidColorBrush x:Key="DesignInsetFill" Color="#171B24" /><SolidColorBrush x:Key="SuiteHoverFill" Color="#2C3443"/><SolidColorBrush x:Key="SuiteOffFill" Color="#343C4B"/><SolidColorBrush x:Key="SuiteSwitchOnFill" Color="#333D51"/><SolidColorBrush x:Key="SuiteSwitchAccent" Color="#92B9FF"/>
          <LinearGradientBrush x:Key="SuitePreviewCanvas" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#354A64" Offset="0"/><GradientStop Color="#202D40" Offset="1"/></LinearGradientBrush><SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#333D51"/><SolidColorBrush x:Key="NavigationViewContentBackground" Color="#171B24" />
          <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#171B24" />
          <SolidColorBrush x:Key="DesignStroke" Color="#3D4451" />
          <SolidColorBrush x:Key="SemanticBlue" Color="#92B9FF" />
          <SolidColorBrush x:Key="SemanticPurple" Color="#B7A9FF" />
          <SolidColorBrush x:Key="SemanticGreen" Color="#80D4BF" />
          <SolidColorBrush x:Key="SemanticAmber" Color="#EDBE80" />
          <SolidColorBrush x:Key="SemanticPink" Color="#EFA6C5" />
          <SolidColorBrush x:Key="SemanticCyan" Color="#7BCEE6" />
