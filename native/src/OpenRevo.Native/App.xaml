          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3D4451"/>
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3D4451"/>
          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#3D4451"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#3D4451"/>
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3D4451"/>
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3D4451"/>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3D4451"/>
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#3D4451"/>
          <SolidColorBrush x:Key="SliderTrackFill" Color="#3D4451"/>
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3D4451"/>
          <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#3D4451"/>
          <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#3D4451"/>
          <SolidColorBrush x:Key="SliderThumbBackground" Color="#92B9FF"/>
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#92B9FF"/>
          <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#92B9FF"/>
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="#92B9FF"/>
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#92B9FF"/>
          <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#92B9FF"/>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#92B9FF"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#92B9FF"/>
