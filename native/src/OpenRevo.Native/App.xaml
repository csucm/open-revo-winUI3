          <SolidColorBrush x:Key="ChoiceText" Color="#92B9FF" />
          <SolidColorBrush x:Key="DetailBadgeFill" Color="#0D2847" />
          <SolidColorBrush x:Key="OverviewInk" Color="#EEF1F8" /><SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EEF1F8"/><SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#ACB6C8"/>
          <SolidColorBrush x:Key="OverviewMuted" Color="#ACB6C8" />
        
